# ============================================================
# Frontend Environment Variables
# ============================================================
# Copy this file to .env for local development.
# In production (Hostinger), set these as environment variables
# in your hosting control panel / build settings.

# Backend API base URL (no trailing slash, no /api suffix)
# Local:      http://localhost:5000
# Production: https://api.scholarslee.com
VITE_API_URL=https://api.scholarslee.com
